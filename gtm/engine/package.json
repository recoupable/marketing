{
  "name": "@recoupable/gtm",
  "version": "0.1.0",
  "private": true,
  "description": "Go-to-market tooling for Recoupable — user export, email sequences, growth dashboard",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "export-users": "tsx scripts/exportUsers.ts",
    "sync-attio": "tsx scripts/syncAttio.ts",
    "dashboard": "tsx scripts/buildDashboard.ts",
    "build": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "recover-enrichment": "node --experimental-strip-types scripts/recoverEnrichment.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0"
  }
}
